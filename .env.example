# --- required ---
# from @BotFather
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# transcription only; unused if TRANSCRIBE_PROVIDER=none
FAL_KEY=

# Your Telegram chat id. Leave blank on first run: message the bot and it
# will log "OWNER_CHAT_ID not set - your chat id is <N>". Then set it.
# The bot ignores every other chat.
OWNER_CHAT_ID=

# --- storage ---
# Local path. In the container this is /data, on a volume: see Deploy in the README.
DATA_DIR=./data

# --- model ---
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# --- transcription ---
# fal | whispercpp | none
TRANSCRIBE_PROVIDER=fal
# ElevenLabs Scribe, $0.03/min. Better on accented and technical speech, which
# is most of what a 2-minute voice note about infrastructure is. The transcript
# IS the substance, so accuracy here sets the ceiling on draft quality.
# Cheaper alternative: fal-ai/whisper (Whisper large-v3). Same output field.
FAL_TRANSCRIBE_MODEL=fal-ai/elevenlabs/speech-to-text
# blank = auto-detect. "en" to force English.
TRANSCRIBE_LANGUAGE=
# only for TRANSCRIBE_PROVIDER=whispercpp
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# --- schedule ---
TIMEZONE=UTC
# daily interview question
QUESTION_HOUR=9
# daily /review push
REVIEW_HOUR=18
# how often to look for cleared substance to draft
DRAFT_SWEEP_MINUTES=10

# --- content ---
DRAFTS_PER_SUBSTANCE=4
REVIEW_BATCH=3
# pick one lane and hold it
CONTENT_LANGUAGE=English

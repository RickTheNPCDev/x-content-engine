# --- required ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
ANTHROPIC_API_KEY=
FAL_KEY=                       # transcription only; unused if TRANSCRIBE_PROVIDER=none

# Your Telegram chat id. Leave blank on first run: message the bot and it
# will log "OWNER_CHAT_ID not set - your chat id is <N>". Then set it.
# The bot ignores every other chat.
OWNER_CHAT_ID=

# --- storage ---
# On Railway: attach a volume and set this to the mount path (e.g. /data).
# Anything not on the volume is wiped on every deploy.
DATA_DIR=./data

# --- model ---
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max

# --- transcription ---
TRANSCRIBE_PROVIDER=fal        # fal | whispercpp | none
# ElevenLabs Scribe, $0.03/min. Better on accented and technical speech, which
# is most of what a 2-minute voice note about infrastructure is. The transcript
# IS the substance, so accuracy here sets the ceiling on draft quality.
# Cheaper alternative: fal-ai/whisper (Whisper large-v3). Same output field.
FAL_TRANSCRIBE_MODEL=fal-ai/elevenlabs/speech-to-text
TRANSCRIBE_LANGUAGE=           # blank = auto-detect. "en" to force English.
WHISPER_CPP_BIN=               # only for TRANSCRIBE_PROVIDER=whispercpp
WHISPER_CPP_MODEL=

# --- schedule ---
TIMEZONE=UTC
QUESTION_HOUR=9                # daily interview question
REVIEW_HOUR=18                 # daily /review push
DRAFT_SWEEP_MINUTES=10         # how often to look for cleared substance to draft

# --- content ---
DRAFTS_PER_SUBSTANCE=4
REVIEW_BATCH=3
CONTENT_LANGUAGE=English       # pick one lane and hold it
